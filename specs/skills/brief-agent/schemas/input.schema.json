{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars.sequeldigital.solutions/schemas/brief-agent/input.schema.json",
  "title": "ARS Brief Agent — Input",
  "description": "Canonical input contract consumed by the Brief Agent v1.0. Validated before invocation. Per spec §2.3.",
  "type": "object",
  "required": [
    "brand_id",
    "brand_voice_intake",
    "topic_signal",
    "tier_context",
    "lever_state",
    "session_id"
  ],
  "additionalProperties": false,
  "properties": {
    "brand_id": {
      "type": "string",
      "minLength": 2,
      "description": "Active brand identifier. Must match a Brand Voice Intake on file.",
      "examples": ["REINVENTED"]
    },
    "brand_voice_intake": {
      "type": "object",
      "description": "Full Brand Voice Intake JSON. All 11 sections required.",
      "required": [
        "brand_id",
        "voice_attributes",
        "messaging_pillars",
        "audience_definition",
        "do_say",
        "do_not_say",
        "entity_firewall",
        "visual_canon",
        "audio_canon",
        "cta_library",
        "platform_targets"
      ],
      "additionalProperties": true
    },
    "topic_signal": {
      "type": "object",
      "required": ["topic", "reason", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string", "minLength": 4, "maxLength": 240 },
        "reason": { "type": "string", "minLength": 4, "maxLength": 600 },
        "source": { "type": "string", "enum": ["trend_hunter", "manual", "operator_override"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "competing_angles": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 200 },
          "maxItems": 8
        }
      }
    },
    "tier_context": {
      "type": "string",
      "enum": ["Pilot", "Starter", "Pro", "Enterprise"]
    },
    "prior_briefs": {
      "type": "array",
      "description": "Last 5 briefs for this brand, oldest first. Used for format diversification.",
      "items": { "type": "object" },
      "maxItems": 5,
      "default": []
    },
    "manual_override": {
      "type": ["string", "null"],
      "maxLength": 600,
      "default": null,
      "description": "Operator-forced angle. If non-null, Brief Agent must honor while still passing entity firewall + tier checks."
    },
    "lever_state": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "Lever Graduation state — 3 = first 30 reels (every brief reviewed), 2 = sampled (1-in-5), 1 = full autonomy."
    },
    "session_id": {
      "type": "string",
      "pattern": "^ars-\\d{4}-\\d{2}-\\d{2}-\\d{3,}$",
      "description": "Run identifier in the form ars-YYYY-MM-DD-NNN.",
      "examples": ["ars-2026-04-27-001"]
    }
  }
}
